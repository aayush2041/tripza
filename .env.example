# ==============================================================================
# TripZa - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your local environment and fill in your values.
# NEVER commit the actual '.env' file containing real secrets or credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed client origin for CORS and future WebSocket connections
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB)
# Local development instance: mongodb://127.0.0.1:27017/tripza_dev
# Or MongoDB Atlas development connection string: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tripza_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tripza_dev

# Session & Security Secrets
# Generate a cryptographically secure random string with at least 32 characters
SESSION_SECRET=replace_this_with_a_secure_random_string_min_32_chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite / React)
# ------------------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser client.
# NEVER put private keys, database passwords, or session secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:5000/api
